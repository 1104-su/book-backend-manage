<% var base = '/?keyword=' + encodeURIComponent(keyword) + '&page='; %>
<div class="pagination">
  <span class="page-nav">
    <span class="page-text">上一页</span>
    <a class="page-arrow" href="<%= base + 1 %>">&lt;</a>
    <% for (var p = 1; p <= totalPages; p++) { %>
      <% if (p === page) { %>
        <span class="page-num current"><%= p %></span>
      <% } else { %>
        <a class="page-num" href="<%= base + p %>"><%= p %></a>
      <% } %>
    <% } %>
    <a class="page-arrow" href="<%= base + totalPages %>">&gt;</a>
    <span class="page-text">下一页</span>
  </span>
  <span class="page-total">共<%= totalPages %>页</span>
  <form class="jump-form" method="get" action="/">
    <input type="hidden" name="keyword" value="<%= keyword %>">
    <span>到第</span>
    <input type="text" name="page" class="jump-page" size="3">
    <span>页</span>
    <button type="submit" class="jump-btn">确定</button>
  </form>
</div>
